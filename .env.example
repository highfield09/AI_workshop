# Start with the offline provider so the notebook works without credentials.
LLM_PROVIDER=demo

# OpenAI cloud (never commit a real key).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

# Local OpenAI-compatible server. Ollama's default endpoint is shown here.
LOCAL_LLM_BASE_URL=http://localhost:11434/v1
LOCAL_LLM_API_KEY=ollama
LOCAL_LLM_MODEL=qwen3:8b

# Existing classroom vLLM/LiteLLM gateway.
CLASSROOM_BASE_URL=http://localhost:4000/v1
CLASSROOM_API_KEY=
CLASSROOM_MODEL=classroom-qwen

# Optional catch-all OpenAI-compatible service.
CUSTOM_LLM_BASE_URL=
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=

