{
  "name": "Vibe Coding Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "./scripts/setup_environment.sh",
  "forwardPorts": [8888],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ms-vscode.live-server"
      ],
      "settings": {
        "jupyter.askForKernelRestart": false
      }
    }
  }
}
