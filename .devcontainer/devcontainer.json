{
  "name": "Vibe Coding Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "./_for_TRAINER/scripts/setup_environment.sh",
  "forwardPorts": [8888, 5500],
  "portsAttributes": {
    "5500": {
      "label": "Catalogue Live Server"
    },
    "8888": {
      "label": "JupyterLab"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers",
        "GitHub.copilot",
        "GitHub.copilot-chat",
        "ritwickdey.LiveServer",
        "Mescius.spreadjs-xlsx-editor"
      ],
      "settings": {
        "jupyter.askForKernelRestart": false
      }
    }
  }
}
