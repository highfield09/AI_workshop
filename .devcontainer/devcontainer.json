{
  "name": "LLM Workshop",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "python -m pip install --upgrade pip && python -m pip install -r requirements.txt && python -m ipykernel install --user --name llm-workshop --display-name 'Python (LLM Workshop)'",
  "forwardPorts": [8888, 11434, 4000],
  "portsAttributes": {
    "8888": {
      "label": "JupyterLab"
    },
    "11434": {
      "label": "Local LLM API"
    },
    "4000": {
      "label": "Classroom LLM gateway"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "jupyter.askForKernelRestart": false
      }
    }
  }
}

