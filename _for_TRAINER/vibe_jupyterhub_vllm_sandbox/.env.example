# Model location. Mount the repository root so snapshot symlinks to blobs remain valid.
QWEN_MODEL_ROOT=/home/highfieldc/LLM_Lab/cache/hub/models--Qwen--Qwen3.5-9B
QWEN_SNAPSHOT_ID=c202236235762e1c871ad0ccb60c8ee5ba337b9a

# Images
VLLM_IMAGE=vllm/vllm-openai:v0.25.1-cu129-ubuntu2404
LITELLM_IMAGE=docker.litellm.ai/berriai/litellm-database:latest
JUPYTERHUB_IMAGE=vibe-jupyterhub:latest
JUPYTER_USER_IMAGE=vibe-classroom-user:latest

# Local-only ports
LOCAL_HUB_PORT=8000
LOCAL_GATEWAY_PORT=4000

# Initial sandbox identities
JUPYTERHUB_ALLOWED_USERS=instructor,student1,student2
JUPYTERHUB_ADMIN_USERS=instructor

# Generated by scripts/generate_secrets.sh
JUPYTERHUB_USER_PASSWORDS_JSON='{"instructor":"CHANGE_ME","student1":"CHANGE_ME","student2":"CHANGE_ME"}'
JUPYTERHUB_COOKIE_SECRET=CHANGE_ME
LITELLM_MASTER_KEY=sk-CHANGE_ME
LITELLM_SALT_KEY=CHANGE_ME
VLLM_INTERNAL_KEY=sk-CHANGE_ME
POSTGRES_PASSWORD=CHANGE_ME

# Per-student virtual-key policy
STUDENT_KEY_DURATION=30d
STUDENT_RPM_LIMIT=6
STUDENT_TPM_LIMIT=12000
STUDENT_MAX_PARALLEL_REQUESTS=1

# Per-student container limits
STUDENT_MEM_LIMIT=4G
STUDENT_CPU_LIMIT=2.0

# A5000-safe initial vLLM limits; raise after measuring free VRAM.
VLLM_MAX_MODEL_LEN=8192
VLLM_GPU_MEMORY_UTILIZATION=0.88
VLLM_MAX_NUM_SEQS=4
VLLM_MAX_CUDAGRAPH_CAPTURE_SIZE=8

# Optional headless Chromium in the student image: 1 enables it, 0 omits it.
INSTALL_BROWSER=0

# Public HTTPS mode. The default edge publishes ONLY the LLM API.
# Create a DNS A/AAAA record for LLM_DOMAIN and allow inbound TCP 80/443.
LLM_DOMAIN=llm.example.edu
ACME_EMAIL=admin@example.edu

# Reserved for edge/Caddyfile.with-hub.example after replacing the sandbox
# sandbox password authenticator with institutional OIDC/OAuth.
HUB_DOMAIN=hub.example.edu
